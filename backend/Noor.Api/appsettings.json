{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=NoorDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Noor.Store",
    "Audience": "Noor.Web",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Store": {
    "Currency": "INR",
    "FreeShippingThreshold": 1999,
    "StandardShippingCost": 99,
    "ExpressShippingCost": 249,
    "TaxRate": 0,
    "SupportEmail": "care@noor.store"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Database": {
    "AutoMigrate": false
  }
}
